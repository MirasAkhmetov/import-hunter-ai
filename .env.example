# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/import_hunter?schema=public"

# OpenAI API (optional — mock mode works without it)
OPENAI_API_KEY="sk-..."

# Mock mode — set to "true" to use mock data instead of real parsers
MOCK_MODE="true"

# Mock brand contacts — ONLY works when BOTH MOCK_MODE=true AND this is true
# Default: false — production never shows fabricated contacts
MOCK_BRAND_CONTACTS_ENABLED=false

# Wildberries — destination region (default Moscow)
WB_DEST=-1257786
# Optional HTTP proxy for WB requests (not yet wired — use system proxy)
WB_REQUEST_PROXY=

# Ozon — optional region cookie value
OZON_REGION=
